# 合约部署环境变量配置示例
# 复制此文件为 .env.contract 并填入真实值

# ========== RPC节点配置 ==========
# ETH主网RPC URL
ETH_MAINNET_RPC_URL=https://eth.llamarpc.com
# 或者使用Infura: https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# 或者使用Alchemy: https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Sepolia测试网RPC URL
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# ========== 部署账户私钥 ==========
# 部署合约的私钥（注意：主网部署请使用硬件钱包或多签）
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# ========== Etherscan API密钥 ==========
# 用于验证合约代码
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ========== 合约配置参数 ==========
# USDT合约地址（ETH主网）
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# 资金池地址
TREASURY_ADDRESS=0x571Bb55E5e16bdd3A994b8f5D09DaF44Cd61aA9a

# 管理员地址
ADMIN_ADDRESS=0x40016e5d0024d0D6dA9C7b945Cce810BcE602279

# ========== 可选配置 ==========
# Gas报告
REPORT_GAS=false

# Coinmarketcap API密钥（用于Gas价格转换）
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here


