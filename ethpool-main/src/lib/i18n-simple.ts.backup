// 获取浏览器语言
export const getBrowserLanguage = (): Language => {
  if (typeof window === 'undefined') return 'en'
  
  const browserLang = navigator.language.toLowerCase()
  
  if (browserLang.startsWith('zh')) {
    if (browserLang === 'zh-tw' || browserLang === 'zh-hk') {
      return 'zh-tw'
    }
    return 'zh'
  }
  
  if (browserLang.startsWith('ko')) return 'ko'
  if (browserLang.startsWith('ja')) return 'ja'
  if (browserLang.startsWith('hi')) return 'hi'
  if (browserLang.startsWith('ms')) return 'ms'
  if (browserLang.startsWith('fil') || browserLang.startsWith('tl')) return 'fil'
  if (browserLang.startsWith('fr')) return 'fr'
  if (browserLang.startsWith('de')) return 'de'
  if (browserLang.startsWith('it')) return 'it'
  if (browserLang.startsWith('es')) return 'es'
  if (browserLang.startsWith('nl')) return 'nl'
  if (browserLang.startsWith('ru')) return 'ru'
  
  return 'en' // 默认英文
}

// 获取翻译函数
export const getTranslation = (language: Language): TranslationContent => {
  return translations[language] || translations.en
} 